# Copy this file to .env and fill in your own keys

# Supabase project URL and SERVICE ROLE key (Project Settings -> API).
# The service role key must stay on the server, never in the frontend.
SUPABASE_URL=
SUPABASE_KEY=

# Google Gemini (resume parsing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Groq (skill gaps, roadmaps, cover letters)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Job matching: "gemini" (hosted, no PyTorch - recommended for deployment)
# or "local" (sentence-transformers; also run: pip install -r requirements-local-embeddings.txt)
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Job search APIs (at least one source is required)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
JOOBLE_API_KEY=
JOB_LOCATION=India

# Where LangGraph saves analysis progress.
# Leave DATABASE_URL empty to use a local SQLite file (fine for local development).
# For deployment use your Supabase Postgres connection string
# (Project Settings -> Database -> Connection string -> "Session pooler").
DATABASE_URL=
CHECKPOINT_DB=checkpoints.sqlite

# Frontend URLs allowed to call the API (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,https://agentic-job-ai.netlify.app

# Optional: trace every graph run in LangSmith
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agentic-job-ai
